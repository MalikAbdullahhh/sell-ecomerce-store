# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8080
ADMIN_URL=http://localhost:8080
# Extra origins (comma-separated) for production, e.g. https://your-app.vercel.app
EXTRA_CORS_ORIGINS=

# MongoDB — include the database name in the path
# Example Atlas: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/focus-frame-store?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/focus-frame-store

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=change_me_to_another_long_random_secret
ADMIN_JWT_EXPIRES_IN=1d

# Default admin — synced into Mongo on every boot while ADMIN_SYNC_FROM_ENV=true
ADMIN_EMAIL=admin@aperture.tech
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Aperture Admin
ADMIN_SYNC_FROM_ENV=true

# Email (order confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Aperture <noreply@aperture.tech>"

# Uploads — set to a positive number to cap MB per file; leave 0 / blank for no limit
UPLOAD_MAX_MB=0

# Cloudinary — Dashboard → Settings → API Keys
# Set these on the BACKEND Vercel project (not the frontend), then redeploy.
# Key + Secret must be from the SAME API key row.
# If CLOUDINARY_URL is also set, remove it so it cannot override these three.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Media library folder prefix — NOT the cloud name (e.g. gadgetsgoodpk)
CLOUDINARY_FOLDER=gadgetsgoodpk
# Optional alternative (only if the three vars above are blank):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
