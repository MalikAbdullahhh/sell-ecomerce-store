# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8080
ADMIN_URL=http://localhost:8080

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27018/focus-frame-store

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=change_me_to_another_long_random_secret
ADMIN_JWT_EXPIRES_IN=1d

# Default admin (seeded on first run)
ADMIN_EMAIL=admin@aperture.tech
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Aperture Admin

# Email (order confirmations) — fill with your SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Aperture <noreply@aperture.tech>"

# Uploads
UPLOAD_MAX_MB=25
